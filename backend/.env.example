# ── core ──
PORT=5000
MONGO_URL=mongodb://127.0.0.1:27017/thejournalism
MONGO_DB_BACKUP=mongodb://127.0.0.1:27017/thejournalism_backup
ACCESS_TOKEN_SECRET=lllinehojvlneflweulnfnsmvpemflfjwoefjnlmflsjfjlks
ACCESS_TOKEN_EXPIRES=1d
REFRESH_TOKEN_SECRET=lkflkdsjfldspowejmnvoretioertpommvo98yulsfwe
REFRESH_TOKEN_EXPIRES=30d

FRONTEND_URL=http://localhost:3000
FRONTEND_URL_PROD=https://www.example.com
FRONTEND_URL_PROD2=

ADMIN_URL=http://localhost:5173
IMG_URL=https://img.spriteera.com          # media server (/upload, /upload-video, /deleteImage)

# ── SEO / sitemap ──
SITE_NAME=The Journalism
SITE_URL=https://www.example.com           # canonical base for all sitemap + JSON-LD urls
SITE_LANG=hi
SITE_LOCALE=hi_IN
SITE_LOGO=https://www.example.com/logo.png
SEO_DEFAULT_IMAGE=https://www.example.com/og-default.jpg
TWITTER_SITE=@thejournalism
SITEMAP_LIMIT=1000                         # urls per sitemap page (max 1000 here)
SITEMAP_CACHE_SECONDS=300
# override page url patterns if your frontend routes differ (defaults shown in config/seo.config.js)
# SEO_PATHS={"news":"/news/:id","category":"/category/:slug","live":"/live/:slug"}
ROBOTS_DISALLOW=/dashboard,/admin,/api

# ── YouTube auto extract (videos + shorts) ──
YT_AUTO_SYNC=false                         # true = cron runs
YT_CHANNEL_IDS=UCxxxxxxxxxxxxxxxxxxxxxx    # comma separated channel ids (UC...)
YOUTUBE_API_KEY=                           # optional: enables full backfill + real durations/tags
YT_SYNC_CRON=*/15 * * * *
YT_DEFAULT_LOCATION=india

# ── uploads ──
MAX_VIDEO_MB=300
# Label saved on every uploaded short/video: cloudflare-r2 | cloudflare-stream | media-server
# (a media-server answer that contains hlsUrl / uid / key / provider overrides it per file)
VIDEO_STORAGE_PROVIDER=media-server

# ── roles / access ──
# Public self sign-up (POST /user/create) is closed by default. Admins create accounts via POST /admin/add-reporter.
ALLOW_PUBLIC_SIGNUP=false

# ── cache ──
# Leave empty for the built-in in-memory LRU cache (single server).
# Set it (and `pnpm add ioredis`) to share cache + invalidation across several servers.
REDIS_URL=
CACHE_PREFIX=news:
CACHE_MAX_ENTRIES=2000

# ── fastify server ──
HOST=0.0.0.0
LOG_LEVEL=info              # fatal | error | warn | info | debug (default: info in production, warn otherwise)
TRUST_PROXY=false           # true when behind nginx / a load balancer (real client IP in logs)
MAX_VIDEO_MB=300
# Label saved on every uploaded short/video: cloudflare-r2 | cloudflare-stream | media-server
# (a media-server answer that contains hlsUrl / uid / key / provider overrides it per file)
VIDEO_STORAGE_PROVIDER=media-server
# Firebase push: either keep serviceAccountKey.json next to index.js, or put the JSON here. Neither = push disabled.
FIREBASE_SERVICE_ACCOUNT=
